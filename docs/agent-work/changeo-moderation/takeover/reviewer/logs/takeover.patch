+        String label=switch(withdrawal) { case SENSITIVE_PREFERENCE->"SENSITIVE";case ADULT_PREFERENCE->"ADULT";default->"GENERAL"; };
+        byte[] bytes=text.getBytes(StandardCharsets.UTF_8);
+        var ref=workbench.save(new WorkbenchService.Draft(UUID.randomUUID(),Optional.empty(),0,text,label,"PRIVATE",Optional.empty(),Optional.of(viewer),List.of(new WorkbenchService.Upload("text/plain",bytes))));
+        submit(ref);runReview(ref);activate(ref);
+        var file=reader.retrieve(ref.resourceId()).attachments().getFirst();
+        Runnable mutation=switch(withdrawal) {
