import json,re
from pathlib import Path
root=Path('/home/paradis/changeo')
role=root/'docs/agent-work/changeo-implementation'
files=[*sorted((root/'docs').glob('*.md')),*sorted(role.glob('*.md'))]
errors=[]
count=0
for path in files:
    content=path.read_text()
    if len(re.findall(r'^```',content,re.M))%2: errors.append('Unbalanced fences: '+str(path))
    for target in re.findall(r'\[[^\]]+\]\(([^)]+)\)',content):
        if re.match(r'^(?:https?://|app://)',target): continue
        name,sep,fragment=target.partition('#')
        dest=(path.parent/name).resolve() if name else path
        count+=1
        if not dest.exists():
            errors.append('Missing target: '+str(path)+' -> '+target)
        elif sep:
            headings=re.findall(r'^#{1,6}\s+(.+)$',dest.read_text(),re.M)
            anchors={re.sub(r'[^\w\- ]','',h.lower()).replace(' ','-') for h in headings}
            if fragment not in anchors: errors.append('Missing heading: '+str(path)+' -> '+target)
for artifact in ['../changeo-gate0/reviewer/report.md','../changeo-gate0/coordinator-report.md','../changeo-gate0/coordinator-final-check.txt','child-routing.json','root-routing.json','logs/routing-doctor.log']:
